{
  "title": "Heart Risk API - Overview",
  "uid": "heart-risk-api-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["heart-risk", "mlops-assignment"],
  "panels": [
    {
      "id": 1,
      "title": "Request rate by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(heart_api_http_requests_total[5m])) by (status)",
          "legendFormat": "status {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by path",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(heart_api_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (4xx/5xx)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(heart_api_http_requests_total{status=~\"4..|5..\"}[5m])) / sum(rate(heart_api_http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Predictions per minute, by label",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(heart_api_predictions_total[1m])) by (label) * 60",
          "legendFormat": "{{label}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Median prediction confidence",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(heart_api_prediction_confidence_bucket[10m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Total requests served",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(heart_api_http_requests_total)", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "API pods reporting (via Prometheus targets)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(up{job=\"heart-risk-api\"} == 1)", "refId": "A" }
      ]
    }
  ]
}
